{
  "id": "br3tech-app",
  "name": "BR3 Tech — Laboratório e Gestão de Assistência Técnica",
  "short_name": "BR3 Tech",
  "description": "Sistema completo de gestão de ordens de serviço, diagnósticos de hardware, checklist e laboratório de tecnologia da BR3 Tech.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#090d16",
  "theme_color": "#090d16",
